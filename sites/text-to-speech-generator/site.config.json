{
  "key": "text-to-speech-generator",
  "domain": "texttospeechgenerator.example.com",
  "brand": {
    "appName": "Text to Speech Generator",
    "appUrl": "https://texttospeechgenerator.example.com",
    "supportEmail": "support@texttospeechgenerator.example.com",
    "logo": "/logo.png",
    "favicon": "/favicon.ico",
    "previewImage": "/logo.png"
  },
  "capabilities": {
    "enabledModules": [
      "auth",
      "billing",
      "admin_settings",
      "storage",
      "analytics",
      "affiliate",
      "customer_service",
      "ads"
    ],
    "paymentProvider": "creem"
  },
  "i18n": {
    "defaultLocale": "en",
    "supportedLocales": ["en"],
    "localePrefix": "as-needed",
    "localeDetection": false,
    "strictPublishing": true
  },
  "configVersion": 2
}
