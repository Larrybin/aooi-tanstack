{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "scripts/ci.ts",
    "scripts/site-gate.ts",
    "scripts/site-contract.ts",
    "scripts/cloudflare.ts",
    "scripts/cloudflare/**/*.ts",
    "scripts/run-with-site.ts",
    "scripts/run-tests.ts",
    "scripts/generate-site-module.ts",
    "scripts/generate-content-source-module.mts",
    "scripts/generate-route-tree.ts",
    "scripts/generate-paraglide.ts",
    "scripts/check-site-i18n.ts",
    "scripts/check-site-i18n-glossary.ts",
    "scripts/check-site-i18n-schema.ts",
    "scripts/check-client-bundle-boundary.ts",
    "scripts/check-site-home-server-imports.ts",
    "scripts/list-sites.ts",
    "scripts/postinstall.ts",
    "scripts/site-schema.ts",
    "scripts/lib/build-paths.ts",
    "scripts/lib/current-site.ts",
    "scripts/lib/public-content-manifest.ts",
    "scripts/lib/site-capabilities.ts",
    "scripts/lib/site-config.ts",
    "scripts/lib/site-content-config.ts",
    "scripts/lib/site-i18n-check.ts",
    "scripts/lib/site-i18n-content-assets.ts",
    "scripts/lib/site-i18n-content-gates.ts",
    "scripts/lib/site-i18n-glossary.ts",
    "scripts/lib/site-i18n-pages.ts",
    "scripts/lib/site-pricing.ts",
    "scripts/lib/site-route-assembly.ts",
    "src/config/load-dotenv-core.ts",
    "src/config/site-env.ts",
    "src/config/product-modules/registry.ts",
    "src/shared/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".generated", ".source"]
}
