    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-start": "1.168.42",
    "@types/mdx": "^2.0.14",
    "ai": "^5.0.39",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^15.7.12",
    "fumadocs-mdx": "^11.10.0",
    "fumadocs-ui": "^15.7.12",
    "github-markdown-css": "^5.8.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.17.0",
    "markdown-it": "^14.1.1",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "overtype": "^1.2.6",
    "parse5": "^7.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.77.0",
    "react-icons": "^5.5.0",
    "react-use-measure": "^2.1.7",
    "recharts": "2.15.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.3.1",
    "resend": "^6.12.4",
    "rough-notation": "^0.5.1",
    "shiki": "^4.1.0",
    "simple-flakeid": "^0.0.5",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.1",
    "@eslint/eslintrc": "^3.3.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/paraglide-js": "2.18.2",
    "@inlang/plugin-message-format": "4.4.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/router-generator": "1.167.17",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.18",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.34",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.37.0",
    "playwright": "1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "8.61.0",
    "vite": "7.3.6",
    "wrangler": "4.99.0"
  },
  "pnpm": {
    "overrides": {
      "ajv@^6.12.4": "6.14.0",
      "brace-expansion@1": "1.1.13",
      "brace-expansion@2": "2.0.3",
      "defu": "6.1.7",
      "dompurify": "3.4.0",
