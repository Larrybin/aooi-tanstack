{
  "name": "aooi-tanstack",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "author": "Larrybin",
  "homepage": "https://github.com/Larrybin/aooi-tanstack",
  "repository": {
    "type": "git",
    "url": "https://github.com/Larrybin/aooi-tanstack.git"
  },
  "keywords": [
    "ai-saas-boilerplate",
    "ai-saas-template",
    "ai-saas-framework",
    "ai-saas-development"
  ],
  "scripts": {
    "dev": "tsx scripts/run-with-site.ts pnpm exec vite dev --config vite.config.mts",
    "dev:local": "SITE=dev-local tsx scripts/run-with-site.ts pnpm exec vite dev --config vite.config.mts",
    "build": "tsx scripts/run-with-site.ts pnpm exec vite build --config vite.config.mts",
    "start": "tsx scripts/run-with-site.ts pnpm exec vite preview --config vite.config.mts",
    "typecheck": "tsx scripts/run-with-site.ts pnpm exec tsc --noEmit --pretty false --incremental false && pnpm exec tsc --project tsconfig.scripts.json --noEmit --pretty false --incremental false",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "ci": "tsx scripts/ci.ts",
    "release:check": "pnpm run ci && pnpm cf:check && pnpm cf:build && pnpm cf:typegen:check",
    "test": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/run-tests.ts",
    "site-home-server:check": "tsx scripts/check-site-home-server-imports.ts",
    "test:extended": "pnpm test:auth-spike",
    "test:auth-spike": "node --import tsx scripts/smoke.mjs auth-spike",
    "test:creem-webhook-spike": "node --test --import tsx \"src/infra/adapters/payment/creem.test.ts\" \"tests/contract/payment-notify.test.ts\"",
    "test:r2-upload-spike": "node --test --import tsx \"src/server/api/storage/upload-image-route.server.test.ts\"",
    "test:coverage": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/run-tests.ts --coverage",
    "i18n:check": "tsx scripts/check-site-i18n.ts",
    "i18n:glossary:check": "tsx scripts/check-site-i18n-glossary.ts",
    "i18n:schema:check": "tsx scripts/check-site-i18n-schema.ts",
    "lint": "tsx scripts/run-with-site.ts pnpm exec eslint . --report-unused-disable-directives",
    "lint:deps": "tsx scripts/run-with-site.ts pnpm exec depcruise --config dependency-cruiser.cjs --output-type err-long apps/web src cloudflare scripts tests",
    "arch:graph": "pnpm lint:deps",
    "arch:semantic": "node --test --import tsx \"src/architecture-boundaries.test.ts\"",
    "arch:check": "pnpm arch:graph && pnpm arch:semantic",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "conventions:draft": "node scripts/conventions-index.mjs --out .codex/drafts/CONVENTIONS.generated.md",
    "conventions:check": "node scripts/conventions-index.mjs --check",
    "db:generate": "npx drizzle-kit generate --config=src/infra/adapters/db/config.ts",
    "db:migrate": "npx drizzle-kit migrate --config=src/infra/adapters/db/config.ts",
    "db:check": "npx tsx scripts/check-db-schema.ts",
    "db:push": "npx drizzle-kit push --config=src/infra/adapters/db/config.ts",
    "db:studio": "npx drizzle-kit studio --config=src/infra/adapters/db/config.ts",
    "auth:generate": "tsx scripts/run-with-site.ts pnpm exec @better-auth/cli generate --config=src/infra/platform/auth/index.ts",
    "rbac:init": "npx tsx scripts/init-rbac.ts",
    "rbac:assign": "npx tsx scripts/assign-role.ts",
    "postinstall": "tsx scripts/postinstall.ts",
    "cf:check": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/cloudflare.ts check",
    "cf:build": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/cloudflare.ts build",
    "cf:build:no-db": "tsx scripts/cloudflare.ts build-no-db",
    "cf:deploy": "pnpm cf:deploy:app",
    "cf:deploy:state": "pnpm cf:check && tsx scripts/run-with-site.ts pnpm exec tsx scripts/cloudflare.ts deploy-state",
    "cf:deploy:app": "pnpm cf:check && pnpm cf:build && tsx scripts/run-with-site.ts pnpm exec tsx scripts/cloudflare.ts deploy-app",
    "site:contract": "tsx scripts/site-contract.ts",
    "site:list": "tsx scripts/list-sites.ts",
    "site:gate": "tsx scripts/site-gate.ts",
    "release:cf": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/cloudflare.ts release",
    "cf:typegen": "tsx scripts/cloudflare.ts typegen",
    "cf:typegen:check": "tsx scripts/cloudflare.ts typegen-check",
    "paraglide:compile": "tsx scripts/run-with-site.ts pnpm exec tsx scripts/generate-paraglide.ts",
    "client:boundary": "tsx scripts/check-client-bundle-boundary.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.89",
    "@hookform/resolvers": "^5.2.1",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-checkbox": "^1.3.11",
