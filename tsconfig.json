{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".tanstack/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@/site": ["./.generated/sites/dev-local/site.ts"],
      "@/site-home": ["./.generated/sites/dev-local/site-home.tsx"],
      "@/site-home-server": [
        "./.generated/sites/dev-local/site-home.server.ts"
      ],
      "@/content-source": ["./.generated/sites/dev-local/content-source.ts"],
      "@/public-content": ["./.generated/sites/dev-local/public-content.ts"],
      "@/route-tree": ["./.generated/sites/dev-local/routeTree.gen.ts"],
      "@/paraglide/*": ["./.generated/sites/dev-local/paraglide/*"]
    }
  },
  "include": [
    ".generated/sites/dev-local/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cloudflare/**/*.ts"
  ],
  "exclude": [
    "tests",
    "scripts/**/*.test.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "apps/web/src/routes/(module_*)/**",
    "apps/web/src/routes/(site_*)/**",
    "node_modules",
    "out",
    "dist",
    "raphael-starterkit-v1-main"
  ]
}
